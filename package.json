{
  "name": "tony-rodriguez-portfolio",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "check:ai": "bash scripts/check-ai-instructions.sh",
    "check:skills": "node scripts/check-skills.mjs",
    "check:design": "node scripts/check-design.mjs",
    "lint": "node scripts/check-lint.mjs",
    "test:tooling": "node --test --test-isolation=none tests/tooling/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.js",
    "ai:context": "node scripts/ai-memory.mjs context",
    "ai:health": "node scripts/ai-memory.mjs health",
    "ai:outcome": "node scripts/ai-memory.mjs outcome",
    "ai:route": "node scripts/ai-route.mjs",
    "ai:brief": "node scripts/session-brief.mjs",
    "ai:sync": "node scripts/sync-skills.mjs",
    "ai:eval": "node scripts/check-agent-evals.mjs",
    "ai:loop": "node scripts/ai-loop.mjs",
    "perf:report": "node scripts/performance-report.mjs"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "csv-parser": "^3.2.0",
    "framer-motion": "^10.16.16",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.303.0",
    "papaparse": "^5.5.3",
    "parquetjs": "^0.11.2",
    "parquetjs-lite": "^0.8.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vercel/functions": "^3.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  }
